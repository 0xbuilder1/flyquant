{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/cloud-xyz.bin",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/cloud-index.bin",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/activity.bin",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/stats.json",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/stats",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    }
  ]
}
