{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)\.bin", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/api/stats", "headers": [{ "key": "cache-control", "value": "no-store" }] },
    { "source": "/stats.json", "headers": [{ "key": "cache-control", "value": "no-store" }] },
    { "source": "/activity.bin", "headers": [{ "key": "cache-control", "value": "no-store" }] }
  ]
}
